# HTTPS for the one-server install. Certificates are automatic (Let's Encrypt).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:3000/internal/domain-check
	}
}

(app) {
	@internal path /internal/*
	respond @internal 404
	reverse_proxy api:3000
}

# Your domain: the website at /, the owner app at /app.
{$APP_DOMAIN} {
	import app
}

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

# Any other domain you later point here for a business.
https:// {
	tls {
		on_demand
	}
	import app
}
